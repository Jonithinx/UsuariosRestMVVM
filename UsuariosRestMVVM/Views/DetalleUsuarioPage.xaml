<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UsuariosRestMVVM.ViewModels"
             x:Class="UsuariosRestMVVM.Views.DetalleUsuarioPage"
             x:DataType="vm:DetalleUsuarioViewModel"
             Title="Detalle de Usuario"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}">

    <Grid Padding="16">
        <ScrollView>
            <VerticalStackLayout Spacing="16">

                <!-- Error -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#450A0A}"
                        Stroke="{AppThemeBinding Light=#EF4444, Dark=#DC2626}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light=#991B1B, Dark=#FCA5A5}"
                           FontSize="14" />
                </Border>

                <!-- Tarjeta de detalle -->
                <Border IsVisible="{Binding HasUsuario}"
                        Padding="20"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D30}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E20}">
                    <VerticalStackLayout Spacing="16">

                        <!-- Encabezado con ID y Nombre -->
                        <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                            <Border WidthRequest="56"
                                    HeightRequest="56"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 28"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#312E81}">
                                <Label Text="{Binding Usuario.Id, StringFormat='#{0}', FallbackValue='#'}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Border>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Usuario"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Text="{Binding Usuario.Name, FallbackValue=''}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D30}" />

                        <!-- Campo: ID -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="ID"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            <Label Text="{Binding Usuario.Id, FallbackValue=''}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                        </VerticalStackLayout>

                        <!-- Campo: Name -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Nombre completo"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            <Label Text="{Binding Usuario.Name, FallbackValue=''}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                        </VerticalStackLayout>

                        <!-- Campo: Email -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Correo electrónico"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            <Label Text="{Binding Usuario.Email, FallbackValue=''}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                        </VerticalStackLayout>

                        <!-- Campo: Phone -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Teléfono"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            <Label Text="{Binding Usuario.Phone, FallbackValue=''}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                        </VerticalStackLayout>

                        <!-- Campo: Website -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Sitio web"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            <Label Text="{Binding Usuario.Website, FallbackValue=''}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Indicador de carga -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
